{
  "name": "alcydeo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev:chrome": "pnpm --filter @alcydeo/extension dev",
    "typecheck": "pnpm --filter @alcydeo/extension typecheck && pnpm --filter @alcydeo/website typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/fixtures.mjs",
    "bench": "node scripts/benchmark.mjs",
    "build:chrome": "node scripts/locales.mjs && node scripts/brand.mjs && node scripts/conversion-assets.mjs && node scripts/notices.mjs && pnpm --filter @alcydeo/extension build",
    "zip:chrome": "pnpm --filter @alcydeo/extension zip && node scripts/check-package.mjs",
    "crx:chrome": "node scripts/crx.mjs",
    "docs:build": "node scripts/website-content.mjs && pnpm --filter @alcydeo/website build && node scripts/check-site.mjs",
    "fixtures:large": "tsx scripts/large-fixture.ts",
    "docs:preview": "pnpm --filter @alcydeo/website preview",
    "notices": "node scripts/notices.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "zip:store": "node scripts/store-build.mjs",
    "test:store": "node scripts/store-qa.mjs",
    "zip:pages": "pnpm docs:build && node scripts/pages-archive.mjs",
    "zip:brand": "node scripts/brand.mjs && node scripts/brand-archive.mjs",
    "test:ci": "node scripts/ci-e2e.mjs",
    "build:firefox": "node scripts/firefox-build.mjs",
    "zip:firefox": "node scripts/firefox-build.mjs --zip",
    "zip:source": "node scripts/source-archive.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@mediabunny/aac-encoder": "1.65.0",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.12.0",
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "googlevideo": "5.0.1",
    "mediabunny": "1.65.0",
    "mp4box": "2.5.0",
    "mux.js": "6.3.0",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
