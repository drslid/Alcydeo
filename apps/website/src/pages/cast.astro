---
import { version } from '../../../../package.json';
import catalogs from '../../../../packages/i18n/catalogs.json';
import castIcon from '../../../../packages/design-tokens/icons/material/cast.svg?raw';
import playIcon from '../../../../packages/design-tokens/icons/material/play_arrow.svg?raw';
import pauseIcon from '../../../../packages/design-tokens/icons/material/pause.svg?raw';
const keys=['tv','help','tvWebHint','tvWebOpen','tvWebPreparing','tvWebLoad','tvWebLoadError','tvWebSdkError','tvWebNoMedia','tvWebStop','tvDisconnected','tvConnected','tvConnecting','tvNoConnection','tvNoDevice','tvHint','tvNetworkHint','tvWebPlay','pause','tvWebTitle','tvWebPreviewUnavailable','tvWebPlayerSeek','tvWebPlayerVolume','tvWebFullscreen','tvWebExitFullscreen','tvWebUsingOriginal','tvWebSource','tvCast_loading','tvCast_playing','tvCast_paused','tvCast_finished','tvCastTimeout','technicalDetails','detectionDiagnosticsCopy','detectionDiagnosticsCopied','detectionDiagnosticsPrivacy','tvOriginal'];
const messages=Object.fromEntries(Object.entries(catalogs).map(([locale,catalog])=>[locale,Object.fromEntries(keys.map(key=>[key,(catalog as Record<string,string>)[key]]))]));
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<!doctype html><html lang="en" data-theme="system"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="referrer" content="no-referrer"><title>Alcydeo · Google Cast</title><link rel="icon" href={`${base}/favicon.svg`}><link rel="stylesheet" href={`${base}/cast/sender.css`}></head><body><main data-version={version}>
<header><img src={`${base}/brand/kingfisher-icon.svg`} alt="" width="44" height="44"><strong>Alcydeo</strong><span>Google Cast · {version}</span></header>
<section class="cast-card"><h1 data-message="tvWebTitle">Google Cast</h1><h2 id="media-title" dir="auto"></h2><p id="source-kind" hidden data-message="tvWebUsingOriginal"></p>
<div class="player-shell"><video id="player" controls playsinline preload="metadata"></video><div id="receiver" hidden><span class="cast-icon" aria-hidden="true" set:html={castIcon}></span><span id="receiver-name" dir="auto"></span></div>
<div id="player-controls" hidden>
<label class="timeline"><span class="sr-only" data-message="tvWebPlayerSeek"></span><input id="seek" type="range" min="0" max="1" step="0.1" value="0" dir="ltr" disabled></label>
<div class="player-toolbar">
<button id="pause" class="player-button" type="button" disabled><span class="play-icon" aria-hidden="true" set:html={playIcon}></span><span class="pause-icon" aria-hidden="true" hidden set:html={pauseIcon}></span></button>
<bdi id="time" dir="ltr">0:00 / 0:00</bdi>
<label class="player-volume"><span class="sr-only" data-message="tvWebPlayerVolume"></span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 9h4l5-4v14l-5-4H3z"/><path class="volume-wave" d="M16 8a6 6 0 0 1 0 8"/></svg><input id="volume" type="range" min="0" max="1" step="0.05" value="1" dir="ltr" disabled></label>
<button id="choose" class="player-button" type="button" disabled><span class="cast-icon" aria-hidden="true" set:html={castIcon}></span><span class="sr-only" data-message="tvWebOpen"></span></button>
<button id="fullscreen" class="player-button" type="button"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg></button>
</div></div></div>
<p id="preview-notice" hidden data-message="tvWebPreviewUnavailable"></p><p id="status" role="status"></p><p id="error" role="alert" hidden></p><a id="source-page" class="secondary source-page" target="_blank" rel="noreferrer noopener" hidden data-message="tvOriginal"></a><details id="diagnostic" hidden><summary data-message="technicalDetails"></summary><p data-message="detectionDiagnosticsPrivacy"></p><pre id="diagnostic-report" dir="ltr"></pre><button id="copy-diagnostic" class="secondary" type="button" data-message="detectionDiagnosticsCopy"></button><p id="diagnostic-copy-status" role="status"></p></details>
<div class="actions"><button id="load" class="secondary" type="button" disabled hidden data-message="tvWebLoad"></button><button id="disconnect" class="secondary" type="button" disabled hidden data-message="tvWebStop"></button></div>
<form id="media-form" hidden><label><span data-message="tvWebSource"></span><input id="media-url" type="url" dir="ltr" autocomplete="off" placeholder="https://…/video.mp4"></label><button class="secondary" type="submit" data-message="tvWebLoad"></button></form>
<details class="player-help"><summary data-message="help"></summary><p data-message="tvHint"></p><p data-message="tvWebHint"></p><p data-message="tvNetworkHint"></p></details></section>
<footer>Google Cast · <a href="https://developers.google.com/cast/docs/web_sender" target="_blank" rel="noreferrer">Google</a></footer></main><script id="cast-messages" type="application/json" set:html={JSON.stringify(messages).replace(/</g,'\\u003c')}></script><script is:inline src={`${base}/cast/sender.js`}></script></body></html>
