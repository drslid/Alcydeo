---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const languages = [['en','English'],['es','Español'],['fr','Français'],['de','Deutsch'],['zh-cn','简体中文'],['ar','العربية'],['ru','Русский'],['pt','Português'],['hi','हिन्दी'],['ur','اردو']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Page not found · Alcydeo</title>
    <link rel="icon" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <main>
      <a href={`${base}/`} aria-label="Alcydeo home"><img src={`${base}/brand/wordmark-dark.svg`} alt="Alcydeo" width="200" height="64" /></a>
      <p class="code">404</p>
      <h1>Page not found.</h1>
      <p>The address may have changed. Open a guide in your language.</p>
      <nav aria-label="Languages">{languages.map(([lang,label]) => <a href={`${base}/${lang}/`} lang={lang} dir={lang==='ar'||lang==='ur'?'rtl':'ltr'}>{label}</a>)}</nav>
      <a class="back" href={`${base}/`}>Back to Alcydeo <span aria-hidden="true">↗</span></a>
    </main>
  </body>
</html>
<style>
  :global(html){background:#071b2d;color:#eef5fc;color-scheme:dark;font-family:system-ui,sans-serif}
  :global(body){margin:0;padding:2rem;min-height:100vh;box-sizing:border-box;display:grid;place-items:center}
  main{max-width:40rem;line-height:1.8}img{max-width:100%;height:auto}
  .code{color:#69b5ef;margin:3rem 0 .5rem;font-size:.9rem}h1{margin:0;font-size:clamp(2rem,6vw,3rem);line-height:1.2;letter-spacing:-.025em}
  p{color:#a9bdcf}nav{display:flex;flex-wrap:wrap;gap:.75rem 1.5rem;margin-block:2rem}
  a{color:#69b5ef;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible{outline:3px solid #2dd4bf;outline-offset:4px}.back{display:inline-flex;gap:1rem}
  @font-face{font-family:AlcydeoArabic;src:url('../../public/fonts/NotoNaskhArabic-arabic.woff2') format('woff2');font-weight:400 700;font-display:swap;unicode-range:U+0600-06FF,U+0750-077F,U+0870-08FF,U+FB50-FDFF,U+FE70-FEFF}
  @font-face{font-family:AlcydeoDevanagari;src:url('../../public/fonts/NotoSansDevanagari-devanagari.woff2') format('woff2');font-weight:400 700;font-display:swap;unicode-range:U+0900-097F,U+A8E0-A8FF}
  :lang(ar),:lang(ur){font-family:AlcydeoArabic,sans-serif;font-size:1.05rem}:lang(hi){font-family:AlcydeoDevanagari,sans-serif}
</style>
